{
  "name": "courrier",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/native.mjs run",
    "dev": "node scripts/native.mjs run",
    "dev:relay": "pnpm --filter @courrier/relay dev",
    "package": "node scripts/native.mjs package",
    "build": "turbo run build && node scripts/native.mjs build",
    "build:services": "turbo run build",
    "build:macos": "swift build --disable-sandbox --package-path apps/macos",
    "build:windows": "node scripts/native.mjs build win32",
    "test": "turbo run test && node scripts/native.mjs test",
    "test:services": "turbo run test",
    "test:macos": "swift test --disable-sandbox --package-path apps/macos",
    "test:windows": "node scripts/native.mjs test win32",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
