<Window
    x:Class="Courrier.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Courrier.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Courrier.Windows.Models"
    mc:Ignorable="d"
    Title="Courrier">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New message" Click="NewMessage_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="Message">
                <MenuFlyoutItem Text="Reply" Click="Reply_Click" />
                <MenuFlyoutItem Text="Reply all" Click="ReplyAll_Click" />
                <MenuFlyoutItem Text="Forward" Click="Forward_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Archive" Click="ArchiveSelection_Click" />
                <MenuFlyoutItem Text="Move to Trash" Click="TrashSelection_Click" />
                <MenuFlyoutItem Text="Mark read or unread" Command="{x:Bind ViewModel.ToggleReadCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Search" Click="FocusSearch_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings" Click="Settings_Click" />
            </MenuBarItem>
        </MenuBar>

        <Grid
            x:Name="OnboardingGrid"
            Grid.Row="1"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel
                Width="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="54"
                    Glyph="&#xE715;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="Welcome to Courrier" />
                <TextBlock
                    Text="Connect an Outlook or Gmail account. Credentials stay protected by Windows."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.SignInMicrosoftCommand}"
                    Content="Continue with Microsoft"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.SignInGoogleCommand}"
                    Content="Continue with Google" />
                <InfoBar
                    x:Name="OnboardingError"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="MailGrid"
            Grid.Row="1"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" MinWidth="190" />
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        Grid.Row="0"
                        Margin="0,4,0,12"
                        HorizontalAlignment="Stretch"
                        Click="NewMessage_Click"
                        Content="New message"
                        Style="{ThemeResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <ListView
                        x:Name="FolderList"
                        Grid.Row="1"
                        AllowDrop="True"
                        DragOver="FolderList_DragOver"
                        Drop="FolderList_Drop"
                        IsItemClickEnabled="True"
                        ItemClick="FolderList_ItemClick"
                        ItemsSource="{x:Bind ViewModel.Folders}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MailFolder">
                                <Grid
                                    MinHeight="38"
                                    Margin="{x:Bind Depth, Converter={StaticResource FolderDepthToMarginConverter}}"
                                    Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Margin="4,0,12,0"
                                        FontSize="16"
                                        Glyph="&#xE8A8;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Label}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,4,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind UnreadCount}"
                                        Visibility="{x:Bind UnreadCount, Converter={StaticResource CountToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <ComboBox
                            x:Name="AccountPicker"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.Accounts}"
                            SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                Command="{x:Bind ViewModel.SignInMicrosoftCommand}"
                                Content="Add Outlook" />
                            <Button
                                Command="{x:Bind ViewModel.SignInGoogleCommand}"
                                Content="Add Gmail" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="16,14,16,8"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.FolderLabel, Mode=OneWay}" />
                <Grid Grid.Row="1" Margin="12,0,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        QueryIcon="Find"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="SearchScope_SelectionChanged">
                        <ComboBoxItem Content="Folder" Tag="Folder" />
                        <ComboBoxItem Content="All mail" Tag="All" />
                    </ComboBox>
                </Grid>
                <CommandBar Grid.Row="2" DefaultLabelPosition="Collapsed">
                    <AppBarButton
                        Icon="Mail"
                        Label="Read or unread"
                        Click="ToggleBulkRead_Click" />
                    <AppBarButton
                        Icon="MoveToFolder"
                        Label="Move"
                        Click="MoveSelection_Click" />
                    <AppBarButton
                        Icon="AllApps"
                        Label="Archive"
                        Click="ArchiveSelection_Click" />
                    <AppBarButton
                        Icon="Delete"
                        Label="Trash"
                        Click="TrashSelection_Click">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarButton
                        Icon="Refresh"
                        Label="Refresh"
                        Command="{x:Bind ViewModel.RefreshCommand}" />
                </CommandBar>
                <ListView
                    x:Name="MessageList"
                    Grid.Row="3"
                    CanDragItems="True"
                    DragItemsStarting="MessageList_DragItemsStarting"
                    IsItemClickEnabled="True"
                    ItemClick="MessageList_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Messages}"
                    DoubleTapped="MessageList_DoubleTapped"
                    SelectionMode="Extended">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MailMessageSummary">
                            <Grid MinHeight="88" Padding="8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="0,7,0,0"
                                    VerticalAlignment="Top"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind IsRead, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}" />
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="2">
                                    <TextBlock
                                        FontWeight="{x:Bind IsRead, Converter={StaticResource ReadStateToWeightConverter}}"
                                        Text="{x:Bind SenderDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Subject}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind Preview}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="{x:Bind FolderLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="8">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ReceivedDisplay}" />
                                    <FontIcon
                                        HorizontalAlignment="Right"
                                        FontSize="13"
                                        Glyph="&#xE723;"
                                        Visibility="{x:Bind HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button
                    Grid.Row="4"
                    Margin="12"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Content="Load more" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid
                    x:Name="ReadingPlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8A8;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select a message to read it" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ReadingContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <CommandBar Grid.Row="0">
                        <AppBarButton Icon="MailReply" Label="Reply" Click="Reply_Click" />
                        <AppBarButton Icon="MailReplyAll" Label="Reply all" Click="ReplyAll_Click" />
                        <AppBarButton Icon="Forward" Label="Forward" Click="Forward_Click" />
                        <AppBarSeparator />
                        <AppBarButton Icon="AllApps" Label="Archive" Command="{x:Bind ViewModel.ArchiveCommand}" />
                        <AppBarButton Icon="MoveToFolder" Label="Move" Click="MoveSelection_Click" />
                        <AppBarButton Icon="Delete" Label="Trash" Command="{x:Bind ViewModel.TrashCommand}" />
                        <AppBarButton Icon="Flag" Label="Star or flag" Command="{x:Bind ViewModel.ToggleStarOrFlagCommand}" />
                        <AppBarButton Icon="Important" Label="Important" Command="{x:Bind ViewModel.ToggleImportantCommand}" />
                        <AppBarButton Icon="BlockContact" Label="Junk" Command="{x:Bind ViewModel.JunkCommand}" />
                    </CommandBar>
                    <StackPanel Grid.Row="1" Margin="20,8,20,12" Spacing="5">
                        <TextBlock
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.MessageDetail.Subject, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.MessageDetail.Sender.Display, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.MessageDetail.ReceivedDisplay, Mode=OneWay}" />
                    </StackPanel>
                    <ItemsControl
                        x:Name="AttachmentList"
                        Grid.Row="2"
                        Margin="20,0,20,8"
                        ItemsSource="{x:Bind ViewModel.MessageDetail.Attachments, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MailAttachment">
                                <Button
                                    Margin="0,0,8,8"
                                    Content="{x:Bind Name}"
                                    Tag="{x:Bind Id}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="Open"
                                                CommandParameter="{Binding}"
                                                Click="Attachment_Open_Click" />
                                            <MenuFlyoutItem
                                                Text="Save as"
                                                CommandParameter="{Binding}"
                                                Click="Attachment_Save_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="3">
                        <ScrollViewer
                            x:Name="TextBodyScroller"
                            Padding="20"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="TextBody"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                        <WebView2
                            x:Name="HtmlBody"
                            NavigationStarting="HtmlBody_NavigationStarting" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="1"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid
            Grid.Row="2"
            MinHeight="28"
            Padding="12,3"
            Background="{ThemeResource LayerFillColorAltBrush}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <ProgressRing
                Width="16"
                Height="16"
                HorizontalAlignment="Right"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
