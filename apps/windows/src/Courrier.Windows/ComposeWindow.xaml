<Window
    x:Class="Courrier.Windows.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Courrier.Windows.Models"
    mc:Ignorable="d"
    Title="Compose">

    <Grid
        x:Name="RootGrid"
        Padding="16"
        IsEnabled="{x:Bind ViewModel.IsEditingEnabled, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.WindowTitle}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" />
        </Grid>

        <AutoSuggestBox
            x:Name="ToBox"
            Grid.Row="1"
            Margin="0,10,0,0"
            Header="To"
            ItemsSource="{x:Bind ViewModel.Suggestions}"
            SuggestionChosen="Recipient_SuggestionChosen"
            Tag="To"
            Text="{x:Bind ViewModel.ToText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="Recipient_TextChanged">
            <AutoSuggestBox.ItemTemplate>
                <DataTemplate x:DataType="models:PersonSuggestion">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Email}" />
                    </StackPanel>
                </DataTemplate>
            </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="CcBox"
                Header="Cc"
                ItemsSource="{x:Bind ViewModel.Suggestions}"
                SuggestionChosen="Recipient_SuggestionChosen"
                Tag="Cc"
                Text="{x:Bind ViewModel.CcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="Recipient_TextChanged" />
            <AutoSuggestBox
                x:Name="BccBox"
                Grid.Column="1"
                Header="Bcc"
                ItemsSource="{x:Bind ViewModel.Suggestions}"
                SuggestionChosen="Recipient_SuggestionChosen"
                Tag="Bcc"
                Text="{x:Bind ViewModel.BccText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextChanged="Recipient_TextChanged" />
        </Grid>

        <TextBox
            Grid.Row="3"
            Margin="0,8,0,0"
            Header="Subject"
            MaxLength="998"
            Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <CommandBar Grid.Row="4" Margin="0,8,0,4" DefaultLabelPosition="Right">
            <AppBarButton
                Icon="Attach"
                Label="Attach"
                Click="Attach_Click" />
            <AppBarButton
                Icon="Bold"
                Label="Bold"
                Click="Bold_Click" />
            <AppBarButton
                Icon="Italic"
                Label="Italic"
                Click="Italic_Click" />
            <AppBarButton
                Icon="Underline"
                Label="Underline"
                Click="Underline_Click" />
        </CommandBar>

        <RichEditBox
            x:Name="BodyEditor"
            Grid.Row="5"
            AcceptsReturn="True"
            AllowDrop="True"
            DragOver="BodyEditor_DragOver"
            Drop="BodyEditor_Drop"
            Header="Message"
            IsSpellCheckEnabled="True"
            PlaceholderText="Write a message"
            TextChanged="BodyEditor_TextChanged"
            TextWrapping="Wrap" />

        <ListView
            x:Name="AttachmentList"
            Grid.Row="6"
            MaxHeight="110"
            Margin="0,8,0,0"
            ItemsSource="{x:Bind ViewModel.Attachments}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LocalAttachment">
                    <Grid MinHeight="40" Padding="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE723;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Size}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Click="RemoveAttachment_Click"
                            Content="Remove" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="7" Margin="0,12,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar
                x:Name="ErrorBar"
                Grid.Column="0"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />
            <Button
                Grid.Column="1"
                Click="Discard_Click"
                Content="Discard" />
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.SendCommand}"
                Content="Send"
                Style="{ThemeResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</Window>
